node_modules/
.env
*.log

# Runtime de squads (saídas/estado do usuário)
squads/*/output/
squads/*/state.json
# Memória de execução por squad (pode conter tema/caso real: sigilo/LGPD)
squads/*/_memory/
# Autos do caso (PDFs do processo, índice e cache de texto: sigilo/LGPD)
squads/*/autos/
# Autos por referência: uma pasta por escritório, casos dentro. Os autos, o texto
# extraído (_texto/, _md/) e o sumário (_sumario/) são do cliente. Pasta de autos fora
# de casos/ que um squads/*/caso.json aponte entra abaixo, ancorada na raiz, pelo
# init, pelo update e pelo squad-modelo --caso.
casos/*/autos/
# Ligação do squad ao caso e identificação da peça (pasta do caso, polo, fase, folha)
squads/*/caso.json
squads/*/identificacao.json

# Memória/instância e sessões do usuário. Diretório inteiro: a memória do chefe cresce
# por arquivo e listar nome a nome deixa o próximo fato escapar para o git do escritório.
_legalsquad/_memory/
_legalsquad/_browser_profile/
_legalsquad/.venv/
_legalsquad/logs/

# Acervo: dados de clientes (sigilo profissional / LGPD)
acervo/casos/

# Config local da IDE
.claude/settings.local.json
skills/_catalog-cache.json

# Onde o motor está NESTA máquina (o init/update regrava; não vale em outra)
_legalsquad/motor/motor.json
