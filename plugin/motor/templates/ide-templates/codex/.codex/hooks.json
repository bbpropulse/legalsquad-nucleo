{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/verifica-citacoes.mjs\""
          },
          {
            "type": "command",
            "command": "node \".codex/hooks/verifica-redacao.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(verificador-citacoes|verificador-persuasao|avaliador-squad|contraditor|revisor-squad|default|worker)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/retorno-subagente.mjs\"",
            "timeout": 60,
            "statusMessage": "LegalSquad · retorno do subagente"
          }
        ]
      }
    ]
  }
}
